‰wΩß¸Ê&¨˛h>'ÆósxÒﬁ˚WÎ—ÚÅ˘rú0NYˇGÊıÓÚﬂ8GõFHÁ„¿Ã7≥j=‡‡6˛Ï	›ô?ò…␀¸¸(◊wN8É⁄ïƒΩy&V>¥—lÚ¸TÛõ9Ú˙˜ú—èπkdGù;≈0—°‘˚?¨”µA˛§'ph›üé1sıg_ÛÿŸgj¯Ú∆ˇoë“PﬂÕxaìvÖ~…˙C˚ÛÎ¡=–Rñ∏õˆ>†ÜÁ¯5æ’Ênw˙á˘¢=<™ÜÂﬁ%ÏY•+ﬂ…_S◊”yº:.§ç´Ú¬»ûxÑ˚Îπ˛H˘åk¡+ªÂòóÆ˘ê“‰Œ÷·X∂!Á:¿dˆË	1?91Ø≠∑Ω©e†gw\ÌŒ´«Âdnª:û'µ¿O;ŸNllá…g1ûπ+␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform sampler2D screen_image : hint_screen_texture, repeat_disable, filter_nearest;
uniform vec4 rectangles[32];
uniform int rectangle_count = 0;
uniform ivec3 xor_color = ivec3(255);
varying vec2 game_position;

void vertex() {
	game_position = VERTEX;
}

void fragment() {
	ivec2 point = ivec2(floor(game_position));
	int parity = 0;
	for (int i = 0; i < rectangle_count; i++) {
		ivec4 box = ivec4(rectangles[i]);
		bool horizontal = point.x >= box.x && point.x <= box.z;
		bool vertical = point.y >= box.y && point.y <= box.w;
		// Original edge writes XOR corners twice, including degenerate boxes.
		if (horizontal && point.y == box.y) { parity = parity ^ 1; }
		if (vertical && point.x == box.x) { parity = parity ^ 1; }
		if (horizontal && point.y == box.w) { parity = parity ^ 1; }
		if (vertical && point.x == box.z) { parity = parity ^ 1; }
	}
	vec3 background = texture(screen_image, SCREEN_UV).rgb;
	ivec3 pixel = ivec3(round(background * 255.0));
	COLOR = vec4(vec3(pixel ^ xor_color) / 255.0, float(parity));
}
