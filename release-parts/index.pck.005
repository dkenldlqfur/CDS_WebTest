àœ»‡!‚yﬂoárR›˝•77¯6ñ=ec»C˝BÊõﬁÙµ˚·RvyÏ	‘õCÃÄ˚Åk•.˝∏"Ã&u◊ƒÓ≥fØ≈«ou‹Â;$ÅæÅ3·ÎI8bNãf?À˝Å$∂ÈÔô'Ó␀1ñ≤mk_‰±†'⁄È/ˆ∆ª–ÂÁ˝Å=©É√á0\èÌ:∂=òÌÚ◊Ò´+}√Àé0í>ãbï≠¡ÅéÔ$ºshader_type canvas_item;
render_mode unshaded;

uniform sampler2D frame_palette : filter_nearest, repeat_disable;
uniform sampler2D label_tags : filter_nearest, repeat_disable;
uniform bool has_label_tags;
varying vec4 tint;

void vertex() {
    tint = COLOR;
}

void fragment() {
    ivec2 extent = textureSize(TEXTURE, 0);
    ivec2 pixel = clamp(ivec2(UV * vec2(extent)), ivec2(0), extent - ivec2(1));
    int index = int(round(texelFetch(TEXTURE, pixel, 0).r * 255.0));
    vec4 color = texelFetch(frame_palette, ivec2(index, 0), 0);
    if (has_label_tags) {
        vec4 tags = texelFetch(label_tags, pixel, 0);
        // Only bitmap ink was written into the frame. Outline ink blends over it.
        if (tags.b < 0.5 && any(notEqual(tags, vec4(0.0)))) {
            color.a = 0.0;
        }
    }
    COLOR = color * tint;
}
